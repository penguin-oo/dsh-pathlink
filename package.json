{
  "name": "dsh-pathlink",
  "version": "0.1.1",
  "description": "Ctrl+click file paths and links in DeepSeek Harness chat: paths open their folder in the OS file manager, links open in a new browser tab.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "path",
    "link",
    "open",
    "web"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penguin-oo/dsh-pathlink.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/schemas.js",
    "lib/typert.host.js",
    "lib/typert.remote-client.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-loader": "^0.1.0-rc.6",
    "esbuild": "^0.25.12",
    "puppeteer-core": "^25.7.0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e-synthetic.mjs"
  }
}
